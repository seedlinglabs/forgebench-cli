{
  "name": "@forgebench/opencode",
  "version": "0.2.0-staging.100",
  "description": "Forgebench plugin for OpenCode 2.x: governed gateway provider, native browser sign-in, model discovery, and direct session, context and trace reporting. No Forgebench CLI required.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/server.d.ts",
      "default": "./server.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./server.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "server.js",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/*.test.js",
    "smoke": "npm run build && node scripts/smoke.mjs",
    "prepack": "npm run build",
    "prepublishOnly": "node scripts/release.mjs guard"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/seedlinglabs/forgebench-cli.git",
    "directory": "packages/forgebench-opencode"
  },
  "devDependencies": {
    "@opencode/plugin": "2.2.2",
    "@types/node": "22.20.0",
    "typescript": "5.9.3"
  },
  "types": "./dist/server.d.ts"
}
